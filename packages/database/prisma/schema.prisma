datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CapabilityStatus {
  SANDBOX
  PRODUCTION_PENDING
  PRODUCTION_APPROVED
  PRODUCTION_ACTIVE
  SUSPENDED
}

enum UserStatus {
  PENDING
  ACTIVE
  KYC_PENDING
  KYC_VERIFIED
  KYC_REJECTED
  SUSPENDED
  SELF_EXCLUDED
  CLOSED
}

enum EventStatus {
  SCHEDULED
  LIVE
  SUSPENDED
  FINISHED
  CANCELLED
  POSTPONED
  ABANDONED
}

enum MarketStatus {
  ACTIVE
  SUSPENDED
  SETTLED
  VOIDED
}

enum SelectionStatus {
  ACTIVE
  SUSPENDED
  WON
  LOST
  VOID
}

enum BetType {
  SINGLE
  ACCUMULATOR
  SYSTEM
}

enum BetStatus {
  PLACED
  WON
  LOST
  VOIDED
  HALF_WON
  HALF_LOST
  CASHED_OUT
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerDirection {
  DR
  CR
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REVERSED
  REFUNDED
}

model Tenant {
  id               String           @id @default(uuid()) @db.Uuid
  code             String           @unique @db.VarChar(64)
  name             String           @db.VarChar(255)
  domain           String           @unique @db.VarChar(255)
  defaultCurrency  String           @default("KES") @db.VarChar(3)
  capabilityStatus CapabilityStatus @default(SANDBOX)
  config           Json             @default("{}")
  createdAt        DateTime         @default(now()) @db.Timestamptz()
  updatedAt        DateTime         @default(now()) @updatedAt @db.Timestamptz()

  users              User[]
  roles              Role[]
  wallets            Wallet[]
  events             Event[]
  markets            Market[]
  betSlips           BetSlip[]
  bets               Bet[]
  ledgerAccounts     LedgerAccount[]
  ledgerTransactions LedgerTransaction[]
  ledgerEntries      LedgerEntry[]
  payments           Payment[]
  riskCases          RiskCase[]
  auditLogs          AuditLog[]
  outboxEvents       OutboxEvent[]

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  phoneNumber  String?    @db.VarChar(32)
  email        String?    @db.VarChar(255)
  passwordHash String     @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  kycTier      Int        @default(1)
  mfaEnabled   Boolean    @default(false)
  mfaSecret    String?    @db.VarChar(255)
  createdAt    DateTime   @default(now()) @db.Timestamptz()
  updatedAt    DateTime   @default(now()) @updatedAt @db.Timestamptz()

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles     UserRole[]
  wallets   Wallet[]
  betSlips  BetSlip[]
  bets      Bet[]
  payments  Payment[]
  riskCases RiskCase[]

  @@unique([tenantId, phoneNumber], name: "uq_tenant_phone")
  @@unique([tenantId, email], name: "uq_tenant_email")
  @@index([tenantId, status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  name        String   @db.VarChar(64)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz()

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Sport {
  id           String        @id @default(uuid()) @db.Uuid
  slug         String        @unique @db.VarChar(64)
  name         String        @db.VarChar(128)
  isActive     Boolean       @default(true)
  competitions Competition[]
  teams        Team[]

  @@map("sports")
}

model Competition {
  id        String   @id @default(uuid()) @db.Uuid
  sportId   String   @db.Uuid
  slug      String   @unique @db.VarChar(128)
  name      String   @db.VarChar(255)
  country   String?  @db.VarChar(64)
  sport     Sport    @relation(fields: [sportId], references: [id])
  events    Event[]

  @@map("competitions")
}

model Team {
  id         String   @id @default(uuid()) @db.Uuid
  sportId    String   @db.Uuid
  name       String   @db.VarChar(255)
  shortName  String?  @db.VarChar(64)
  country    String?  @db.VarChar(64)
  sport      Sport    @relation(fields: [sportId], references: [id])
  homeEvents Event[]  @relation("HomeTeam")
  awayEvents Event[]  @relation("AwayTeam")

  @@map("teams")
}

model Event {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @db.Uuid
  competitionId  String      @db.Uuid
  homeTeamId     String      @db.Uuid
  awayTeamId     String      @db.Uuid
  scheduledStart DateTime    @db.Timestamptz()
  actualStart    DateTime?   @db.Timestamptz()
  status         EventStatus @default(SCHEDULED)
  homeScore      Int         @default(0)
  awayScore      Int         @default(0)
  period         String?     @db.VarChar(32)
  createdAt      DateTime    @default(now()) @db.Timestamptz()
  updatedAt      DateTime    @default(now()) @updatedAt @db.Timestamptz()

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  competition Competition @relation(fields: [competitionId], references: [id])
  homeTeam    Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  markets     Market[]
  betLegs     BetLeg[]

  @@index([tenantId, scheduledStart])
  @@index([tenantId, status])
  @@map("events")
}

model Market {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @db.Uuid
  eventId          String       @db.Uuid
  marketType       String       @db.VarChar(64)
  name             String       @db.VarChar(255)
  status           MarketStatus @default(ACTIVE)
  suspensionReason String?      @db.VarChar(128)
  parameters       Json         @default("{}")
  createdAt        DateTime     @default(now()) @db.Timestamptz()
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz()

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  selections Selection[]
  betLegs    BetLeg[]

  @@index([tenantId, eventId, status])
  @@map("markets")
}

model Selection {
  id           String          @id @default(uuid()) @db.Uuid
  marketId     String          @db.Uuid
  name         String          @db.VarChar(128)
  currentOdds  Decimal         @db.Decimal(8, 4)
  probability  Decimal?        @db.Decimal(6, 4)
  version      Int             @default(1)
  status       SelectionStatus @default(ACTIVE)
  createdAt    DateTime        @default(now()) @db.Timestamptz()
  updatedAt    DateTime        @default(now()) @updatedAt @db.Timestamptz()

  market  Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  betLegs BetLeg[]

  @@index([marketId, status])
  @@map("selections")
}

model Wallet {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  userId         String   @db.Uuid
  currency       String   @db.VarChar(3)
  availableCents BigInt   @default(0)
  heldCents      BigInt   @default(0)
  bonusCents     BigInt   @default(0)
  version        BigInt   @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz()

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  user           User            @relation(fields: [userId], references: [id])
  holds          WalletHold[]
  ledgerAccounts LedgerAccount[]

  @@unique([tenantId, userId, currency], name: "uq_tenant_user_currency")
  @@map("wallets")
}

model WalletHold {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  walletId    String   @db.Uuid
  betId       String   @db.Uuid
  amountCents BigInt
  status      String   @default("ACTIVE") @db.VarChar(32)
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz()

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([tenantId, walletId, status])
  @@map("wallet_holds")
}

model LedgerAccount {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  code      String            @db.VarChar(64)
  type      LedgerAccountType
  walletId  String?           @db.Uuid
  currency  String            @db.VarChar(3)
  createdAt DateTime          @default(now()) @db.Timestamptz()

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  wallet  Wallet?       @relation(fields: [walletId], references: [id])
  entries LedgerEntry[]

  @@unique([tenantId, code, currency, walletId], name: "uq_tenant_account")
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  idempotencyKey String   @db.VarChar(128)
  referenceType  String   @db.VarChar(64)
  referenceId    String   @db.VarChar(128)
  description    String?
  postedAt       DateTime @default(now()) @db.Timestamptz()

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  entries LedgerEntry[]

  @@unique([tenantId, idempotencyKey], name: "uq_tenant_idempotency")
  @@index([tenantId, referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  transactionId String          @db.Uuid
  accountId     String          @db.Uuid
  direction     LedgerDirection
  amountCents   BigInt
  currency      String          @db.VarChar(3)
  createdAt     DateTime        @default(now()) @db.Timestamptz()

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId, accountId])
  @@map("ledger_entries")
}

model BetSlip {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid
  userId               String    @db.Uuid
  type                 BetType
  totalStakeCents      BigInt
  potentialPayoutCents BigInt
  status               BetStatus @default(PLACED)
  idempotencyKey       String    @unique @db.VarChar(128)
  createdAt            DateTime  @default(now()) @db.Timestamptz()
  updatedAt            DateTime  @default(now()) @updatedAt @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  bets   Bet[]

  @@index([tenantId, userId, status])
  @@map("bet_slips")
}

model Bet {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid
  betSlipId            String    @db.Uuid
  userId               String    @db.Uuid
  stakeCents           BigInt
  odds                 Decimal   @db.Decimal(12, 4)
  potentialPayoutCents BigInt
  payoutCents          BigInt    @default(0)
  status               BetStatus @default(PLACED)
  settledAt            DateTime? @db.Timestamptz()
  createdAt            DateTime  @default(now()) @db.Timestamptz()

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  betSlip BetSlip  @relation(fields: [betSlipId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id])
  legs    BetLeg[]

  @@index([tenantId, userId, status])
  @@index([tenantId, settledAt])
  @@map("bets")
}

model BetLeg {
  id           String   @id @default(uuid()) @db.Uuid
  betId        String   @db.Uuid
  eventId      String   @db.Uuid
  marketId     String   @db.Uuid
  selectionId  String   @db.Uuid
  acceptedOdds Decimal  @db.Decimal(8, 4)
  oddsVersion  Int
  status       String   @default("PENDING") @db.VarChar(32)

  bet       Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  event     Event     @relation(fields: [eventId], references: [id])
  market    Market    @relation(fields: [marketId], references: [id])
  selection Selection @relation(fields: [selectionId], references: [id])

  @@map("bet_legs")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  userId         String        @db.Uuid
  provider       String        @db.VarChar(64)
  type           String        @db.VarChar(32) // DEPOSIT | WITHDRAWAL
  amountCents    BigInt
  currency       String        @db.VarChar(3)
  status         PaymentStatus @default(INITIATED)
  providerTxId   String?       @db.VarChar(128)
  idempotencyKey String        @db.VarChar(128)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @db.Timestamptz()
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, idempotencyKey], name: "uq_tenant_payment_idempotency")
  @@index([tenantId, providerTxId])
  @@map("payments")
}

model RiskCase {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  signalType  String   @db.VarChar(64)
  severity    String   @db.VarChar(32) // LOW | MEDIUM | HIGH | CRITICAL
  score       Float
  status      String   @default("OPEN") @db.VarChar(32)
  explanation String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, status])
  @@map("risk_cases")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  actorId       String?  @db.Uuid
  actorType     String   @db.VarChar(32)
  action        String   @db.VarChar(128)
  resourceType  String   @db.VarChar(64)
  resourceId    String   @db.VarChar(128)
  beforeState   Json?
  afterState    Json?
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?
  correlationId String?  @db.VarChar(128)
  createdAt     DateTime @default(now()) @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model OutboxEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  eventName     String   @db.VarChar(128)
  aggregateType String   @db.VarChar(64)
  aggregateId   String   @db.VarChar(128)
  payload       Json
  status        String   @default("PENDING") @db.VarChar(32) // PENDING | PUBLISHED | FAILED
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz()
  publishedAt   DateTime? @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status, createdAt])
  @@map("outbox_events")
}
