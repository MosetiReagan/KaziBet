# KaziBet Platform Configuration

# Platform Mode: SANDBOX | PRODUCTION_PENDING | PRODUCTION_APPROVED | PRODUCTION_ACTIVE | SUSPENDED
KAZIBET_ENVIRONMENT=SANDBOX

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://kazibet_admin:kazibet_secret@localhost:5432/kazibet_db?schema=public"

# Redis Cache & Distributed Locks
REDIS_URL="redis://localhost:6379"

# Kafka / Redpanda Brokers
KAFKA_BROKERS="localhost:9092"

# Security & Tokens
JWT_SECRET="kazibet-insecure-dev-secret-key-min-32-chars"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="7d"

# Default Reference Tenant
DEFAULT_TENANT_CODE="kazi-sports"
DEFAULT_TENANT_NAME="Kazi Sports Reference Book"
DEFAULT_CURRENCY="KES"
DEFAULT_JURISDICTION="KE"

# Service Ports
API_PORT=4000
REALTIME_PORT=4001
AI_PORT=4002
WEB_PORT=3000
ADMIN_PORT=3001

# Sandbox Simulator Controls
SIMULATOR_TICK_INTERVAL_MS=3000
MOCK_PAYMENTS_AUTO_SETTLE=true
